# ==========================================
# 1. PYTHON & BACKEND
# ==========================================
# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / Python Cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment Variables
.env
.env.local
.env.*.local

# Database & SQLite files
*.sqlite3
*.db

# ==========================================
# 2. LOCAL STORAGE & MEDIA (YOUR IMAGES/PDFS)
# ==========================================
# Exclude raw uploaded PDFs, temporary pages, and cropped images
backend/storage/raw_pdfs/*
backend/storage/temp_pages/*
backend/storage/cropped_products/*

# Exclude portable PostgreSQL database files if stored locally in the repo folder
database/pgsql/data/*
*.log
# Exclude the local database folder completely
database/
# Keep the folder structure intact in Git even when empty
!backend/storage/raw_pdfs/.gitkeep
!backend/storage/temp_pages/.gitkeep
!backend/storage/cropped_products/.gitkeep

# ==========================================
# 3. NEXT.JS & FRONTEND
# ==========================================
# Node Dependencies
node_modules/
frontend/node_modules/

# Next.js Build Output & Cache
.next/
frontend/.next/
out/
build/
dist/

# Next.js telemetry & cache
.next/cache/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 4. IDEs & SYSTEM FILES
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# macOS / Windows system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db